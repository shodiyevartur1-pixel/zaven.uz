# ==============================================================================
# ZAVEN ONLINE STORE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and fill in your own project values.
# NEVER commit `.env.local` or real secret keys to version control.
# ==============================================================================

# 1. Public Frontend Supabase Configuration (Safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Single Store Owner Allowlist Email (Used to verify the owner account)
VITE_OWNER_EMAIL=

# 3. Development-Only Local Preview Flag ("true" or "false")
# Set to "true" ONLY during local UI testing when Supabase is not yet connected.
# In production builds (`npm run build`), demo/dev bypass is strictly disabled.
VITE_ENABLE_DEV_DEMO_AUTH=false

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Configure in Supabase Edge Function Secrets / Vault)
# NEVER prefix these with VITE_ and NEVER place them in frontend files!
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# OWNER_ALLOWED_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=